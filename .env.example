# Supabase project used for AI generation. Both values are public by design
# (the publishable key only reaches what RLS and the Edge Function allow).
# Leave empty to use the offline placeholder generator.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to "show" to render the reserved ad slots with a placeholder.
VITE_AD_SLOTS=
